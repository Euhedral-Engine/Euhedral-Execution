#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DIST_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)

export CUDA_DEVICE_ORDER=${CUDA_DEVICE_ORDER:-PCI_BUS_ID}
export TF_CPP_MIN_LOG_LEVEL=${TF_CPP_MIN_LOG_LEVEL:-1}
export TF_CPP_MIN_VLOG_LEVEL=${TF_CPP_MIN_VLOG_LEVEL:-0}
export TF_FORCE_GPU_ALLOW_GROWTH=${TF_FORCE_GPU_ALLOW_GROWTH:-true}

export LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}"
export CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0}
export XLA_FLAGS="--xla_gpu_cuda_data_dir=/usr/local/cuda"

# Suppress warnings (0 = all logs, 1 = hide INFO, 2 = hide INFO/WARNING, 3 = hide ALL)
export TF_CPP_MIN_LOG_LEVEL=2

JAR=$(find "$DIST_DIR" -maxdepth 1 -type f -name 'euhedral-training-*.jar' -print -quit)
if [[ -z "$JAR" ]]; then
  echo "Unable to find the Euhedral trainer jar under $DIST_DIR" >&2
  exit 1
fi

JAVA_ARGS=()
if [[ -n ${JAVA_OPTS:-} ]]; then
  read -r -a JAVA_ARGS <<< "$JAVA_OPTS"
fi

FORWARDED_JVM_ARGS=()
APPLICATION_ARGS=()
READING_JVM_ARGS=true
for argument in "$@"; do
  if $READING_JVM_ARGS && [[ "$argument" == -D* || "$argument" == -X* \
      || "$argument" == --add-opens=* || "$argument" == --enable-preview ]]; then
    FORWARDED_JVM_ARGS+=("$argument")
  else
    READING_JVM_ARGS=false
    APPLICATION_ARGS+=("$argument")
  fi
done

exec java "${JAVA_ARGS[@]}" "${FORWARDED_JVM_ARGS[@]}" \
  -DAllEuhedralLogs=ERROR \
  -jar "$JAR" "${APPLICATION_ARGS[@]}"
