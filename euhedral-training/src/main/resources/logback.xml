<configuration>
  <include resource="logback-fragments/euhedral-core.xml"/>
  <include resource="logback-fragments/euhedral-hardware-utils.xml"/>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%logger{36}] - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>

  <logger name="ch.qos.logback" level="ERROR"/>
  <logger name="ai.djl" level="${DjlLog:-INFO}"/>
  <logger name="org.pytorch" level="${PyTorchLog:-WARN}"/>
</configuration>
