<configuration>
  <appender class="ch.qos.logback.core.ConsoleAppender" name="STDOUT">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%logger{36}] - %msg%n</pattern>
    </encoder>
  </appender>
  <include resource="logback-fragments/euhedral-hardware-utils.xml"/>

  <include resource="logback-fragments/euhedral-core.xml"/>

  <logger level="ERROR" name="io.euhedral_execution.training.merge.data.CalibrationPlanCsv"/>

  <logger level="ERROR" name="io.euhedral_execution.training.SequenceFinder"/>
  <logger level="ERROR" name="io.euhedral_execution.training.ClosedLoopRunner"/>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
