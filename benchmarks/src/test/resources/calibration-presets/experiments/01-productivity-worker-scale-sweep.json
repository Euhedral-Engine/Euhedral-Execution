{
  "schemaVersion": 1,
  "id": "01-productivity-worker-scale-sweep",
  "name": "Productivity Policy Worker Scale Sweep",
  "description": "Measures the zero-body productivity policy from four P-core workers through the exact 7P+15E core-hc-throughput topology after Euhedral excludes core 0 and JMH reserves CPU 31. The scaled series keeps approximately one source per two workers, the fixed series holds eleven sources, and packed-versus-spread E-core sets isolate shared-L2 occupancy.",
  "labels": {
    "preset": "productivity-worker-scale",
    "topology": "i9-14900k-cluster-aware"
  },
  "imports": [
    {
      "path": "../profiles/productivity-threshold.json",
      "namespace": "threshold"
    }
  ],
  "runOptions": {
    "randomizeTrialOrder": true,
    "randomSeed": 401128,
    "failFast": true,
    "repeatCount": 1
  },
  "artifacts": {
    "outputDirectory": "experiments/01-productivity-worker-scale-sweep",
    "retainExpandedConfig": true,
    "retainRawBenchmarkOutput": true,
    "retainObserverData": true,
    "retainPerForkResults": false,
    "retainPerIterationResults": false
  },
  "sweeps": [
    {
      "id": "policy-on-w04-s02",
      "baseTrialId": "scaled-w04-s02",
      "parameters": [{ "path": "/calibrationConfig/productivityThresholdWeight", "values": [128] }]
