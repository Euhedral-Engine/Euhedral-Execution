        "workUnits": 0,
        "randomizeWork": false,
        "totalRequiredExecutions": 8000000,
        "invocationTimeoutMillis": 60000,
        "decisionWeightProfile": "threshold.default-weights",
        "productivityThresholdWeight": 216,
        "lifecycleMode": "RESET",
        "rawSampleLimit": 1024,
