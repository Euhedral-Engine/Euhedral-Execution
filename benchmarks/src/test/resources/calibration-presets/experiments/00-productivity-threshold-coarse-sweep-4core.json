{
  "schemaVersion": 1,
  "id": "00-productivity-threshold-coarse-sweep-4core",
  "name": "Productivity Threshold Coarse Sweep - 4 P-Cores",
  "description": "Locates the coarse fixed-body-cost crossover where parking surplus workers becomes preferable to participation. Each workload has a threshold-zero control and a policy treatment with enough calibrated headroom to capture body-cost variance.",
  "labels": {
    "preset": "productivity-threshold-coarse-sweep",
    "topology": "4-pcore"
  },
  "imports": [
    {
      "path": "../profiles/productivity-threshold.json",
      "namespace": "threshold"
    }
  ],
  "runOptions": {
    "randomizeTrialOrder": true,
    "randomSeed": 400384,
    "failFast": true,
    "repeatCount": 1
  },
  "artifacts": {
    "outputDirectory": "experiments/00-productivity-threshold-coarse-sweep-4core",
    "retainExpandedConfig": true,
    "retainRawBenchmarkOutput": true,
    "retainObserverData": true,
    "retainPerForkResults": false,
    "retainPerIterationResults": false
  },
  "trials": [
    {
      "id": "wu-000-policy-off",
      "name": "Work 0 - Policy Off",
      "group": "productivity-threshold-4core",
      "description": "Fixed zero-work control with productivity parking disabled.",
      "tags": ["coarse", "4core", "policy-off"],
      "enabled": true,
      "forks": 5, "warmups": 2, "iterations": 7,
      "warmupTime": "2s", "measurementTime": "2s",
      "jvmArgs": ["-XX:+UseThreadPriorities", "--enable-native-access=ALL-UNNAMED"],
      "calibrationProfile": "threshold.p4-wu-000-off"
    },
    {
      "id": "wu-000-policy-on",
      "name": "Work 0 - Policy On at 128",
      "group": "productivity-threshold-4core",
      "description": "Fixed zero-work treatment with threshold 128, the prior full-capture dispatch-overhead envelope.",
      "tags": ["coarse", "4core", "policy-on"],
      "enabled": true,
      "forks": 5, "warmups": 2, "iterations": 7,
      "warmupTime": "2s", "measurementTime": "2s",
