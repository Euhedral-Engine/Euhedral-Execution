  "calibrationProfiles": {
    "direct": {
      "cpuSet": [2, 3],
      "parallelSources": 2,
      "orderedSources": 0,
      "workUnits": 0,
      "randomizeWork": false,
      "totalRequiredExecutions": 1000000,
      "invocationTimeoutMillis": 30000,
      "decisionWeightProfile": "forced-direct",
      "rawSampleLimit": 4096,
      "observeCycleStart": false,
      "observeBatchProgress": false,
      "observeBatchComplete": false,
      "observeRawBodyCost": true,
      "observeIdleDecision": false,
      "observeExecDecision": true
    },
    "staged": {
      "cpuSet": [2, 3],
      "parallelSources": 2,
      "orderedSources": 0,
      "workUnits": 0,
      "randomizeWork": false,
      "totalRequiredExecutions": 1000000,
      "invocationTimeoutMillis": 30000,
      "decisionWeightProfile": "forced-staged",
      "rawSampleLimit": 4096,
      "observeCycleStart": false,
      "observeBatchProgress": false,
      "observeBatchComplete": false,
      "observeRawBodyCost": true,
      "observeIdleDecision": false,
      "observeExecDecision": true
    }
  },
  "sweeps": [
    {
      "id": "direct-body-work",
      "baseTrialId": "body-direct",
      "description": "Increase fixed body work while forcing DIRECT.",
      "parameters": [
        {
          "path": "/calibrationConfig/workUnits",
          "values": [0, 48, 96, 144, 192, 216, 240, 288]
        }
      ]
    },
    {
      "id": "staged-body-work",
      "baseTrialId": "body-staged",
      "description": "Increase fixed body work while forcing STAGED.",
      "parameters": [
        {
          "path": "/calibrationConfig/workUnits",
          "values": [0, 48, 96, 144, 192, 216, 240, 288]
        }
      ]
    }
  ],
  "trials": [
    {
      "id": "body-direct",
      "name": "Body Boundary Direct",
      "group": "xh-body-boundary",
      "description": "Forced DIRECT baseline for locating the body cost at which execution-path overhead becomes insignificant.",
      "tags": [
        "body-band",
        "direct",
        "baseline"
      ],
      "enabled": false,
      "forks": 1,
      "warmups": 2,
      "iterations": 5,
      "warmupTime": "3s",
      "measurementTime": "3s",
      "jvmArgs": [
        "-XX:+UseThreadPriorities",
        "--enable-native-access=ALL-UNNAMED"
      ],
      "calibrationProfile": "direct"
    },
    {
      "id": "body-staged",
      "name": "Body Boundary Staged",
      "group": "xh-body-boundary",
      "description": "Forced STAGED candidate for locating the body cost at which execution-path overhead becomes insignificant.",
      "comparison": {
        "baselineTrialId": "body-direct",
        "comparisonGroup": "xh-body-boundary",
        "purpose": "Measure when DIRECT and STAGED throughput converge as body work increases."
      },
      "tags": [
        "body-band",
        "staged",
        "candidate"
      ],
      "enabled": false,
      "forks": 1,
      "warmups": 2,
      "iterations": 5,
      "warmupTime": "3s",
      "measurementTime": "3s",
      "jvmArgs": [
        "-XX:+UseThreadPriorities",
        "--enable-native-access=ALL-UNNAMED"
      ],
      "calibrationProfile": "staged"
    }
  ]
}