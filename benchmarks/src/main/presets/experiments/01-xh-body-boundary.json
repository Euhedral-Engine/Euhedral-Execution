{
  "schemaVersion": 1,
  "id": "01-xh-body-boundary",
  "name": "XH Body Boundary Calibration",
  "description": "Finds the body workload where DIRECT and STAGED execution paths become throughput-equivalent under a low-contention two-core, two-source topology.",
  "labels": {
    "preset": "xh-body-boundary",
    "purpose": "define-xh"
  },
  "runOptions": {
    "randomizeTrialOrder": true,
    "randomSeed": 42,
    "failFast": false,
    "repeatCount": 1
  },
  "artifacts": {
    "outputDirectory": "experiments/01-xh-body-boundary",
    "retainExpandedConfig": true,
    "retainRawBenchmarkOutput": true,
    "retainObserverData": true,
    "retainPerForkResults": true,
    "retainPerIterationResults": true
  },
  "decisionWeightProfiles": {
    "forced-direct": {
      "idleContentionThresholds": {
        "xsContention": 200000,
        "sContention": 400000,
        "mContention": 600000,
        "hContention": 800000
      },
      "idleBodyCostWeights": [
