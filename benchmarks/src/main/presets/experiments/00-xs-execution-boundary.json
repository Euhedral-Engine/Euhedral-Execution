{
  "schemaVersion": 1,
  "id": "00-xs-execution-boundary",
  "name": "XS Execution Boundary Calibration",
  "description": "Compares DIRECT and STAGED execution policies for XS body cost workloads without idle parking",
  "labels": {
    "preset": "xs-execution-boundary"
  },
  "runOptions": {
    "randomizeTrialOrder": false,
    "failFast": false,
    "repeatCount": 1
  },
  "artifacts": {
    "outputDirectory": "experiments/00-xs-execution-boundary",
    "retainExpandedConfig": true,
    "retainRawBenchmarkOutput": true,
    "retainObserverData": true,
    "retainPerForkResults": true,
    "retainPerIterationResults": true
  },
  "imports": [
    {
      "path": "../profiles/00-xs-execution.json",
      "namespace": "xs"
    }
  ],
  "sweeps": [
    {
      "id": "direct-source-count",
      "baseTrialId": "xs-direct",
      "description": "Sweep source count with execution forced DIRECT.",
      "parameters": [
        {
          "path": "/calibrationConfig/parallelSources",
          "values": [1, 2, 8, 16, 32]
        }
      ]
    },
    {
      "id": "staged-source-count",
      "baseTrialId": "xs-staged",
      "description": "Sweep source count with execution forced STAGED.",
      "parameters": [
        {
          "path": "/calibrationConfig/parallelSources",
          "values": [1, 2, 8, 16, 32]
        }
      ]
    }
  ],
  "trials": [
    {
      "id": "xs-direct",
      "name": "XS Direct Execution Policy",
      "group": "xs-execution-boundary",
      "description": "Baseline trial executing XS workloads with forced DIRECT execution policy",
      "hypothesis": "DIRECT execution policy has lower overhead for small work units",
      "tags": [
        "xs",
        "direct",
        "baseline"
      ],
      "enabled": true,
      "forks": 3,
      "warmups": 2,
      "iterations": 5,
      "warmupTime": "2s",
      "measurementTime": "3s",
      "jvmArgs": [
        "-XX:+UseThreadPriorities",
        "--enable-native-access=ALL-UNNAMED"
      ],
      "calibrationProfile": "xs.xs-direct"
    },
    {
      "id": "xs-staged",
      "name": "XS Staged Execution Policy",
      "group": "xs-execution-boundary",
      "description": "Candidate trial executing XS workloads with forced STAGED execution policy",
      "hypothesis": "STAGED execution policy adds queueing overhead for small work units",
      "comparison": {
        "baselineTrialId": "xs-direct",
        "comparisonGroup": "xs-execution-boundary",
        "purpose": "Evaluate performance difference between DIRECT and STAGED execution"
      },
      "tags": [
        "xs",
        "staged",
        "candidate"
      ],
      "enabled": true,
      "forks": 3,
      "warmups": 2,
      "iterations": 5,
      "warmupTime": "2s",
      "measurementTime": "3s",
      "jvmArgs": [
        "-XX:+UseThreadPriorities",
        "--enable-native-access=ALL-UNNAMED"
      ],
      "calibrationProfile": "xs.xs-staged"
    }
  ]
}
