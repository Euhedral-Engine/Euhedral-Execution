{
  "schemaVersion": 1,
  "id": "04-contention-landmarks",
  "name": "Phase 3 Physical Contention Landmarks Exploration",
  "description": "Sweeps source availability, worker counts, and source ordering against fixed calibrated body bands to establish the physical contention continuum and identify distinct contention regimes.",
  "labels": {
    "preset": "contention-landmarks",
    "phase": "3"
  },
  "runOptions": {
    "randomizeTrialOrder": false,
    "failFast": false,
    "repeatCount": 1
  },
  "artifacts": {
    "outputDirectory": "experiments/04-contention-landmarks",
    "retainExpandedConfig": true,
    "retainRawBenchmarkOutput": true,
    "retainObserverData": true,
    "retainPerForkResults": true,
    "retainPerIterationResults": true
  },
  "decisionWeightProfiles": {
    "calibrated-baseline": {
      "idleContentionThresholds": {
        "xsContention": 200000,
        "sContention": 400000,
        "mContention": 600000,
        "hContention": 800000
      },
      "idleBodyCostWeights": [
        { "xs": 96, "s": 128, "m": 216, "h": 288 },
        { "xs": 96, "s": 128, "m": 216, "h": 288 },
        { "xs": 96, "s": 128, "m": 216, "h": 288 },
        { "xs": 96, "s": 128, "m": 216, "h": 288 }
      ],
      "idleTimeNs": [
        { "xsPark": 0, "sPark": 0, "mPark": 0, "hPark": 0, "xhPark": 0 },
        { "xsPark": 0, "sPark": 0, "mPark": 0, "hPark": 0, "xhPark": 0 },
        { "xsPark": 0, "sPark": 0, "mPark": 0, "hPark": 0, "xhPark": 0 },
        { "xsPark": 0, "sPark": 0, "mPark": 0, "hPark": 0, "xhPark": 0 },
        { "xsPark": 0, "sPark": 0, "mPark": 0, "hPark": 0, "xhPark": 0 }
      ],
      "execContentionThresholds": {
        "xsContention": 200000,
        "sContention": 400000,
        "mContention": 600000,
        "hContention": 800000
      },
      "execBodyCostWeights": [
        { "xs": 96, "s": 128, "m": 216, "h": 288 },
        { "xs": 96, "s": 128, "m": 216, "h": 288 },
        { "xs": 96, "s": 128, "m": 216, "h": 288 },
        { "xs": 96, "s": 128, "m": 216, "h": 288 }
      ],
      "executionPolicies": [
        { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" },
        { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" },
        { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" },
        { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" },
        { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" }
      ]
    }
  },
  "calibrationProfiles": {
    "profile-2core-parallel": {
      "cpuSet": [2, 4],
      "parallelSources": 2,
      "orderedSources": 0,
      "workUnits": 48,
      "randomizeWork": false,
      "totalRequiredExecutions": 8000000,
      "invocationTimeoutMillis": 30000,
      "decisionWeightProfile": "calibrated-baseline",
      "rawSampleLimit": 4096,
      "observeCycleStart": true,
      "observeBatchProgress": true,
      "observeBatchComplete": true,
      "observeRawBodyCost": true,
      "observeIdleDecision": false,
      "observeExecDecision": true
    },
    "profile-4core-parallel": {
      "cpuSet": [2, 4, 6, 8],
      "parallelSources": 2,
      "orderedSources": 0,
      "workUnits": 48,
      "randomizeWork": false,
      "totalRequiredExecutions": 8000000,
      "invocationTimeoutMillis": 30000,
      "decisionWeightProfile": "calibrated-baseline",
      "rawSampleLimit": 4096,
      "observeCycleStart": true,
      "observeBatchProgress": true,
      "observeBatchComplete": true,
      "observeRawBodyCost": true,
      "observeIdleDecision": false,
      "observeExecDecision": true
    },
    "profile-2core-ordered": {
      "cpuSet": [2, 4],
      "parallelSources": 0,
      "orderedSources": 1,
      "workUnits": 48,
      "randomizeWork": false,
      "totalRequiredExecutions": 8000000,
      "invocationTimeoutMillis": 30000,
      "decisionWeightProfile": "calibrated-baseline",
      "rawSampleLimit": 4096,
      "observeCycleStart": true,
      "observeBatchProgress": true,
      "observeBatchComplete": true,
      "observeRawBodyCost": true,
      "observeIdleDecision": false,
      "observeExecDecision": true
    }
  },
  "sweeps": [
    {
      "id": "parallel-sources-2core",
      "baseTrialId": "landmark-2core-parallel-base",
      "description": "Sweep parallel source counts across 2 physical cores to observe contention scaling from abundant sources down to single-source bottleneck.",
      "parameters": [
        {
          "path": "/calibrationConfig/parallelSources",
          "values": [16, 8, 4, 2, 1]
        }
      ]
    },
    {
      "id": "parallel-sources-4core",
      "baseTrialId": "landmark-4core-parallel-base",
      "description": "Sweep parallel source counts across 4 physical cores to observe contention scaling under higher worker concurrency.",
      "parameters": [
        {
          "path": "/calibrationConfig/parallelSources",
          "values": [16, 8, 4, 2, 1]
        }
      ]
    },
    {
      "id": "ordered-sources-2core",
      "baseTrialId": "landmark-2core-ordered-base",
      "description": "Sweep ordered source counts across 2 physical cores to observe contention and routing characteristics with ordered frames.",
      "parameters": [
        {
          "path": "/calibrationConfig/orderedSources",
          "values": [1, 2, 4]
        }
      ]
    }
  ],
  "trials": [
    {
      "id": "landmark-2core-parallel-base",
      "name": "2-Core Parallel Sources Contention Sweep",
      "group": "contention-landmarks-2core-parallel",
      "description": "Base trial for sweeping parallel sources on 2 cores.",
      "tags": ["phase3", "contention-landmarks", "2core"],
      "enabled": false,
      "forks": 1,
      "warmups": 2,
      "iterations": 5,
      "warmupTime": "2s",
      "measurementTime": "3s",
      "jvmArgs": [
        "-XX:+UseThreadPriorities",
        "--enable-native-access=ALL-UNNAMED"
      ],
      "calibrationProfile": "profile-2core-parallel"
    },
    {
      "id": "landmark-4core-parallel-base",
      "name": "4-Core Parallel Sources Contention Sweep",
      "group": "contention-landmarks-4core-parallel",
      "description": "Base trial for sweeping parallel sources on 4 cores.",
      "tags": ["phase3", "contention-landmarks", "4core"],
      "enabled": false,
      "forks": 1,
      "warmups": 2,
      "iterations": 5,
      "warmupTime": "2s",
      "measurementTime": "3s",
      "jvmArgs": [
        "-XX:+UseThreadPriorities",
        "--enable-native-access=ALL-UNNAMED"
      ],
      "calibrationProfile": "profile-4core-parallel"
    },
    {
      "id": "landmark-2core-ordered-base",
      "name": "2-Core Ordered Sources Contention Sweep",
      "group": "contention-landmarks-2core-ordered",
      "description": "Base trial for sweeping ordered sources on 2 cores.",
      "tags": ["phase3", "contention-landmarks", "ordered"],
      "enabled": false,
      "forks": 1,
      "warmups": 2,
      "iterations": 5,
      "warmupTime": "2s",
      "measurementTime": "3s",
      "jvmArgs": [
        "-XX:+UseThreadPriorities",
        "--enable-native-access=ALL-UNNAMED"
      ],
      "calibrationProfile": "profile-2core-ordered"
    }
  ]
}
