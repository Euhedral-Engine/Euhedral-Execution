{
  "schemaVersion": 1,
  "id": "03-multiband-verification",
  "name": "Phase 2 Multi-Band Body Cost Weight Verification",
  "description": "Verifies that calibrated decision weights [xs: 96, s: 128, m: 216, h: 288] partition the physical workloads correctly across all 5 discrete body cost bands.",
  "labels": {
    "preset": "multiband-verification",
    "phase": "2"
  },
  "runOptions": {
    "randomizeTrialOrder": false,
    "failFast": false,
    "repeatCount": 1
  },
  "artifacts": {
    "outputDirectory": "experiments/03-multiband-verification",
    "retainExpandedConfig": true,
    "retainRawBenchmarkOutput": true,
    "retainObserverData": true,
    "retainPerForkResults": true,
    "retainPerIterationResults": true
  },
  "decisionWeightProfiles": {
    "calibrated-weights": {
      "idleContentionThresholds": {
        "xsContention": 200000,
        "sContention": 400000,
        "mContention": 600000,
        "hContention": 800000
      },
      "idleBodyCostWeights": [
        { "xs": 96, "s": 128, "m": 216, "h": 288 },
        { "xs": 96, "s": 128, "m": 216, "h": 288 },
        { "xs": 96, "s": 128, "m": 216, "h": 288 },
        { "xs": 96, "s": 128, "m": 216, "h": 288 }
      ],
      "idleTimeNs": [
        { "xsPark": 0, "sPark": 0, "mPark": 0, "hPark": 0, "xhPark": 0 },
        { "xsPark": 0, "sPark": 0, "mPark": 0, "hPark": 0, "xhPark": 0 },
        { "xsPark": 0, "sPark": 0, "mPark": 0, "hPark": 0, "xhPark": 0 },
        { "xsPark": 0, "sPark": 0, "mPark": 0, "hPark": 0, "xhPark": 0 },
        { "xsPark": 0, "sPark": 0, "mPark": 0, "hPark": 0, "xhPark": 0 }
      ],
      "execContentionThresholds": {
        "xsContention": 200000,
        "sContention": 400000,
        "mContention": 600000,
        "hContention": 800000
      },
      "execBodyCostWeights": [
        { "xs": 96, "s": 128, "m": 216, "h": 288 },
        { "xs": 96, "s": 128, "m": 216, "h": 288 },
        { "xs": 96, "s": 128, "m": 216, "h": 288 },
        { "xs": 96, "s": 128, "m": 216, "h": 288 }
      ],
      "executionPolicies": [
        { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" },
        { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" },
        { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" },
        { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" },
        { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" }
      ]
    }
  },
  "calibrationProfiles": {
    "verification-profile": {
      "cpuSet": [2, 4],
      "parallelSources": 2,
      "orderedSources": 0,
      "workUnits": 0,
      "randomizeWork": false,
      "totalRequiredExecutions": 8000000,
      "invocationTimeoutMillis": 30000,
      "decisionWeightProfile": "calibrated-weights",
      "rawSampleLimit": 4096,
      "observeCycleStart": false,
      "observeBatchProgress": false,
      "observeBatchComplete": false,
      "observeRawBodyCost": true,
      "observeIdleDecision": false,
      "observeExecDecision": true
    }
  },
  "sweeps": [
    {
      "id": "workload-sweep",
      "baseTrialId": "multiband-base",
      "description": "Sweep workUnits across all landmark workloads to verify discrete 5-band occupancy.",
      "parameters": [
        {
          "path": "/calibrationConfig/workUnits",
          "values": [0, 48, 96, 144, 192, 216, 240, 288]
        }
      ]
    }
  ],
  "trials": [
    {
      "id": "multiband-base",
      "name": "Multi-Band Base Trial",
      "group": "multiband-verification",
      "description": "Base trial for multi-band verification.",
      "tags": ["verification", "multiband"],
      "enabled": false,
      "forks": 1,
      "warmups": 2,
      "iterations": 5,
      "warmupTime": "2s",
      "measurementTime": "3s",
      "jvmArgs": [
        "-XX:+UseThreadPriorities",
        "--enable-native-access=ALL-UNNAMED"
      ],
      "calibrationProfile": "verification-profile"
    }
  ]
}
