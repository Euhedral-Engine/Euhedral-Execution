{
  "schemaVersion": 1,
  "id": "12-phase-2-productivity-body-coarse",
  "name": "Phase 2 Productivity Body Threshold Coarse Surface",
  "description": "Maps forced productivity exclusion OFF versus ON across measured body cost on the corrected CONTINUOUS 23-worker/11-source anchor. The threshold selector is bypassed during this physical response mapping.",
  "labels": {
    "phase": "phase-2-productivity-body-threshold",
    "purpose": "forced-coarse-surface",
    "topology": "i9-14900k-23-worker-11-source"
  },
  "imports": [
    {
      "path": "../profiles/phase-2-productivity-body-threshold.json",
      "namespace": "phase2"
    }
  ],
  "runOptions": {
    "randomizeTrialOrder": false,
    "balancedTrialOrder": true,
    "failFast": true,
    "repeatCount": 1
  },
  "artifacts": {
    "outputDirectory": "experiments/12-phase-2-productivity-body-coarse",
    "retainExpandedConfig": true,
    "retainRawBenchmarkOutput": true,
    "retainObserverData": true,
    "retainPerForkResults": true,
    "retainPerIterationResults": true
  },
  "sweeps": [
    {
      "id": "phase2-productivity-body-coarse",
      "baseTrialId": "phase2-productivity-body-base",
      "description": "Two independent balanced JVM replicas of forced OFF/ON at each body fixture.",
      "enabled": true,
      "repetitions": 2,
      "group": "phase-2-productivity-body-coarse",
      "parameters": [
        {
          "path": "/calibrationConfig/workUnits",
          "values": [0, 112, 172, 252, 384, 768, 3072, 12288, 98304]
        },
        {
          "path": "/calibrationConfig/productivityGateMode",
          "values": ["FORCE_OFF", "FORCE_ON"]
        }
      ]
    }
  ],
  "trials": [
    {
      "id": "phase2-productivity-body-base",
      "name": "Phase 2 productivity body coarse template",
      "group": "phase-2-productivity-body-coarse",
      "description": "Fixed 23/11 CONTINUOUS fixture; workUnits and forced productivity mode are the only sweep axes.",
      "hypothesis": "Forced exclusion wins for cheap bodies and loses after a measurable body-cost crossover.",
      "tags": ["phase-2", "productivity", "body-cost", "continuous", "forced-on-off", "coarse"],
      "enabled": false,
      "forks": 1,
      "warmups": 2,
      "iterations": 6,
      "warmupTime": "2s",
      "measurementTime": "5s",
      "jvmArgs": [
        "-XX:+UseThreadPriorities",
        "--enable-native-access=ALL-UNNAMED",
        "-Deuhedral.calibration.harnessCpu=0"
      ],
      "calibrationProfile": "phase2.continuous-23w-11s"
    }
  ]
}
