{
  "schemaVersion": 1,
  "id": "04-phase-1-xs-idle-refinement",
  "name": "Phase 1 XS Ordinary Idle Duration Boundary Refinement",
  "description": "Single XS refinement after the coarse response remained favorable at its 50 us endpoint. Retains 50 us as an anchor and bounds the long-duration side without changing another policy parameter.",
  "labels": { "phase": "phase-1-idle-duration", "bodyBand": "XS", "topology": "i9-14900k-23-worker-11-source" },
  "imports": [{ "path": "../profiles/phase-1-idle-duration.json", "namespace": "phase1" }],
  "runOptions": {
    "randomizeTrialOrder": false,
    "balancedTrialOrder": true,
    "failFast": true,
    "repeatCount": 1
  },
  "artifacts": {
    "outputDirectory": "experiments/04-phase-1-xs-idle-refinement",
    "retainExpandedConfig": true,
    "retainRawBenchmarkOutput": true,
    "retainObserverData": true,
    "retainPerForkResults": true,
    "retainPerIterationResults": true
  },
  "sweeps": [
    {
      "id": "xs-idle-refine-ns",
      "baseTrialId": "phase1-xs-refine-base",
      "description": "Two independent JVM replicas per long-side XS treatment, ordered as a complementary pair.",
      "enabled": true,
      "repetitions": 2,
      "group": "phase-1-xs-idle-refinement",
      "parameters": [
        {
          "path": "/calibrationConfig/decisionWeights/idleTimeNs/xsPark",
          "description": "XS ordinary idle duration in nanoseconds",
          "values": [25000, 50000, 100000, 250000, 500000]
        }
      ]
    }
  ],
  "trials": [
    {
      "id": "phase1-xs-refine-base",
      "name": "Phase 1 XS refinement template",
      "group": "phase-1-xs-idle-refinement",
      "description": "True-no-op XS fixture; only xsPark is swept.",
      "tags": ["phase-1", "xs", "continuous", "productivity-off", "refinement"],
      "enabled": false,
      "forks": 1,
      "warmups": 2,
      "iterations": 6,
      "warmupTime": "2s",
      "measurementTime": "5s",
      "jvmArgs": ["-XX:+UseThreadPriorities", "--enable-native-access=ALL-UNNAMED", "-Deuhedral.calibration.harnessCpu=0"],
      "calibrationProfile": "phase1.ordinary-idle-continuous-23w-11s"
    }
  ]
}
