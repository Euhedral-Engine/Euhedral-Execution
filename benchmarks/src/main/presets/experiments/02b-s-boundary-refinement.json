{
  "schemaVersion": 1,
  "id": "02b-s-boundary-refinement",
  "name": "Phase 2 S Landmark Weight Refinement",
  "description": "Refines the decision weight boundary for the S physical body landmark (workUnits = 48) across weights 64..128.",
  "labels": {
    "preset": "s-weight-refinement",
    "phase": "2"
  },
  "runOptions": {
    "randomizeTrialOrder": false,
    "failFast": false,
    "repeatCount": 1
  },
