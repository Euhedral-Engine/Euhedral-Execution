  "trials": [
    {
      "id": "calibrate-s-refine",
      "name": "S Landmark Weight Refinement",
      "group": "s-weight-narrow-sweep",
      "description": "Baseline trial for finding S decision weight.",
      "tags": ["s-band", "weight-calibration"],
      "enabled": false,
      "forks": 1,
      "warmups": 2,
      "iterations": 5,
      "warmupTime": "2s",
      "measurementTime": "3s",
      "jvmArgs": [
        "-XX:+UseThreadPriorities",
        "--enable-native-access=ALL-UNNAMED"
      ],
      "calibrationProfile": "profile-s"
