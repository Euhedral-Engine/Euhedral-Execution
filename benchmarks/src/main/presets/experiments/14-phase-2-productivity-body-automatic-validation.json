{
  "schemaVersion": 1,
  "id": "14-phase-2-productivity-body-automatic-validation",
  "name": "Phase 2 Productivity Body Automatic Validation",
  "description": "Validates one automatic threshold encoding against retained winners from the corrected contention-independent forced 23/11 response surface.",
  "labels": {
    "phase": "phase-2-productivity-body-threshold",
    "purpose": "automatic-policy-validation",
    "topology": "i9-14900k-23-worker-11-source",
    "candidateBoundary": "approximately-105-to-110-measured-ns"
  },
  "imports": [
    {
      "path": "../profiles/phase-2-productivity-body-threshold.json",
      "namespace": "phase2"
    }
  ],
  "runOptions": {
    "randomizeTrialOrder": false,
    "balancedTrialOrder": true,
    "failFast": true,
    "repeatCount": 1
  },
  "artifacts": {
    "outputDirectory": "experiments/14-phase-2-productivity-body-automatic-validation",
    "retainExpandedConfig": true,
    "retainRawBenchmarkOutput": true,
    "retainObserverData": true,
    "retainPerForkResults": true,
    "retainPerIterationResults": true
  },
  "sweeps": [
    {
      "id": "phase2-productivity-body-automatic-validation",
      "baseTrialId": "phase2-productivity-automatic-base",
      "description": "Four independent automatic-policy JVMs at clearly below, near below, near above, and clearly above fixtures.",
      "enabled": true,
      "repetitions": 4,
      "group": "phase-2-productivity-body-automatic-validation",
      "parameters": [
        {
          "path": "/calibrationConfig/workUnits",
          "values": [32, 48, 64, 80]
        },
        {
          "path": "/calibrationConfig/productivityGateMode",
          "values": ["AUTO"]
        },
        {
          "path": "/calibrationConfig/productivityThresholdWeight",
          "values": [48]
        }
      ]
    }
  ],
  "trials": [
    {
      "id": "phase2-productivity-automatic-base",
      "name": "Phase 2 productivity automatic validation template",
      "group": "phase-2-productivity-body-automatic-validation",
      "description": "Fixed 23/11 CONTINUOUS fixture; body cost is the only workload axis and the contention-independent productivity gate uses the candidate automatic threshold.",
      "hypothesis": "Weight 48 resolves near the conservative measured-body boundary and reproduces forced ON below it and forced OFF above it.",
      "tags": ["phase-2", "productivity", "body-cost", "continuous", "automatic-policy", "contention-independent"],
      "enabled": false,
      "forks": 1,
      "warmups": 2,
      "iterations": 6,
      "warmupTime": "2s",
      "measurementTime": "5s",
      "jvmArgs": [
        "-XX:+UseThreadPriorities",
        "--enable-native-access=ALL-UNNAMED",
        "-Deuhedral.calibration.harnessCpu=0"
      ],
      "calibrationProfile": "phase2.continuous-23w-11s"
    }
  ]
}
