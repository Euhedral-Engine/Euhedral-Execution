{
  "schemaVersion": 1,
  "id": "example-harness-config",
  "name": "Example Calibration Harness Configuration",
  "runOptions": {
    "randomizeTrialOrder": false,
    "balancedTrialOrder": false,
    "failFast": true,
    "repeatCount": 1
  },
  "artifacts": {
    "outputDirectory": "build/reports/benchmarks",
    "retainExpandedConfig": true,
    "retainRawBenchmarkOutput": true,
    "retainObserverData": true,
    "retainPerForkResults": false,
    "retainPerIterationResults": false
  },
  "imports": [
    {
      "path": "example_profile_library.json",
      "namespace": "common"
    }
  ],
  "calibrationProfiles": {
    "observed": {
      "cpuSet": [2, 4],
      "parallelSources": 2,
      "orderedSources": 0,
      "workUnits": 100,
      "randomizeWork": true,
      "totalRequiredExecutions": 1000000,
      "invocationTimeoutMillis": 60000,
      "rawSampleLimit": 1024,
      "observeBatchProgress": true,
      "observeBatchComplete": true,
      "idleParkNs": 15000,
      "contentionHalfLifeNanos": 1000000
    }
  },
  "sweeps": [
    {
      "id": "source-count",
      "baseTrialId": "baseline",
      "parameters": [
        {
          "path": "/calibrationConfig/parallelSources",
          "values": [2, 4]
        }
      ]
    }
  ],
  "trials": [
    {
      "id": "baseline",
      "name": "Baseline calibration trial",
      "enabled": true,
      "forks": 3,
      "warmups": 2,
      "warmupTime": "2s",
      "iterations": 5,
      "measurementTime": "5s",
      "jvmArgs": [
        "-XX:+UseThreadPriorities",
        "--enable-native-access=ALL-UNNAMED"
      ],
      "calibrationProfile": "observed"
    },
    {
      "id": "imported",
      "name": "Imported profile trial",
      "enabled": true,
      "forks": 3,
      "warmups": 2,
      "iterations": 5,
      "calibrationProfile": "common.imported-calibration"
    }
  ]
}
