#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BENCHMARK_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

if [ -n "${JAVA_HOME:-}" ]; then
  JAVA_COMMAND="$JAVA_HOME/bin/java"
else
  JAVA_COMMAND=java
fi

exec "$JAVA_COMMAND" \
  -cp "$BENCHMARK_DIR/euhedral-benchmark.jar:$BENCHMARK_DIR/lib/*" \
  io.euhedral_execution.benchmarks.BenchRunner "$@"
