<configuration>
  <include resource="logback-fragments/euhedral-core.xml"/>
  <include resource="logback-fragments/euhedral-hardware-utils.xml"/>

  <appender class="ch.qos.logback.core.ConsoleAppender" name="STDOUT">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%logger{36}] - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>

  <logger name="ch.qos.logback" level="ERROR"/>
</configuration>
