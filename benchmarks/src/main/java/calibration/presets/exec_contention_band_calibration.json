{
  "schemaVersion": 1,
  "id": "exec-contention-band-calibration",
  "name": "Execution Contention Band Calibration",
  "description": "Calibration configuration for execution contention bands",
  "labels": {
    "preset": "contention"
  },
  "runOptions": {
    "randomizeTrialOrder": false,
    "failFast": true,
    "repeatCount": 1
  },
  "artifacts": {
    "outputDirectory": "build/reports/contention-calibration",
    "retainExpandedConfig": true,
    "retainRawBenchmarkOutput": true,
    "retainObserverData": true
  },
  "sweeps": [
    {
      "id": "exec-contention-policy-sweep",
      "baseTrialId": "contention-band-base",
      "description": "Sweep execution policy between staged and direct policies under execution contention",
      "group": "contention-calibration",
      "parameters": [
        {
          "path": "/calibrationConfig/decisionWeights/executionPolicies",
          "description": "Varies execution policy matrix between staged and direct variants",
          "values": [
            [
              { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" },
              { "xsBody": "STAGED", "sBody": "STAGED", "mBody": "STAGED", "hBody": "STAGED", "xhBody": "STAGED" },
              { "xsBody": "STAGED", "sBody": "STAGED", "mBody": "STAGED", "hBody": "STAGED", "xhBody": "STAGED" },
              { "xsBody": "STAGED", "sBody": "STAGED", "mBody": "STAGED", "hBody": "STAGED", "xhBody": "STAGED" },
              { "xsBody": "STAGED", "sBody": "STAGED", "mBody": "STAGED", "hBody": "STAGED", "xhBody": "STAGED" }
            ],
            [
              { "xsBody": "STAGED", "sBody": "STAGED", "mBody": "STAGED", "hBody": "STAGED", "xhBody": "STAGED" },
              { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" },
              { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" },
              { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" },
              { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" }
            ]
          ]
        }
      ]
    }
  ],
  "trials": [
    {
      "id": "contention-band-base",
      "name": "Base Execution Contention Band Trial",
      "group": "contention-calibration",
      "description": "Base trial configuration for execution contention band sweep",
      "tags": [
        "contention",
        "base"
      ],
      "enabled": false,
      "origin": {
        "type": "MANUAL",
        "candidateIndex": 0
      },
      "forks": 1,
      "warmups": 1,
      "iterations": 5,
      "jvmArgs": [
        "-XX:+UseThreadPriorities",
        "--enable-native-access=ALL-UNNAMED"
      ],
      "calibrationConfig": {
        "parallelSources": 11,
        "orderedSources": 0,
        "workUnits": 24,
        "randomizeWork": false,
        "totalRequiredExecutions": 32000000,
        "invocationTimeoutMillis": 6000,
        "decisionWeights": {
          "idleContentionThresholds": {
            "xsContention": 1000000,
            "sContention": 1000000,
            "mContention": 1000000,
            "hContention": 1000000
          },
          "idleBodyCostWeights": [
            { "xs": 0, "s": 0, "m": 0, "h": 0 },
            { "xs": 0, "s": 0, "m": 0, "h": 0 },
            { "xs": 0, "s": 0, "m": 0, "h": 0 },
            { "xs": 0, "s": 0, "m": 0, "h": 0 }
          ],
          "idleTimeNs": [
            { "xsPark": 0, "sPark": 0, "mPark": 0, "hPark": 0, "xhPark": 0 },
            { "xsPark": 0, "sPark": 0, "mPark": 0, "hPark": 0, "xhPark": 0 },
            { "xsPark": 0, "sPark": 0, "mPark": 0, "hPark": 0, "xhPark": 0 },
            { "xsPark": 0, "sPark": 0, "mPark": 0, "hPark": 0, "xhPark": 0 },
            { "xsPark": 0, "sPark": 0, "mPark": 0, "hPark": 0, "xhPark": 0 }
          ],
          "execContentionThresholds": {
            "xsContention": 500000,
            "sContention": 1000000,
            "mContention": 1000000,
            "hContention": 1000000
          },
          "execBodyCostWeights": [
            { "xs": 0, "s": 0, "m": 0, "h": 0 },
            { "xs": 0, "s": 0, "m": 0, "h": 0 },
            { "xs": 0, "s": 0, "m": 0, "h": 0 },
            { "xs": 0, "s": 0, "m": 0, "h": 0 }
          ],
          "executionPolicies": [
            { "xsBody": "DIRECT", "sBody": "DIRECT", "mBody": "DIRECT", "hBody": "DIRECT", "xhBody": "DIRECT" },
            { "xsBody": "STAGED", "sBody": "STAGED", "mBody": "STAGED", "hBody": "STAGED", "xhBody": "STAGED" },
            { "xsBody": "STAGED", "sBody": "STAGED", "mBody": "STAGED", "hBody": "STAGED", "xhBody": "STAGED" },
            { "xsBody": "STAGED", "sBody": "STAGED", "mBody": "STAGED", "hBody": "STAGED", "xhBody": "STAGED" },
            { "xsBody": "STAGED", "sBody": "STAGED", "mBody": "STAGED", "hBody": "STAGED", "xhBody": "STAGED" }
          ]
        },
        "rawSampleLimit": 1024,
        "observeCycleStart": false,
        "observeBatchProgress": false,
        "observeBatchComplete": false,
        "observeRawBodyCost": false,
        "observeIdleDecision": false,
        "observeExecDecision": true
      }
    }
  ]
}
