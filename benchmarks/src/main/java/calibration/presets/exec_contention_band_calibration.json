{
  "schemaVersion": 1,
  "id": "exec-contention-band-calibration",
  "name": "Execution Contention Band Calibration",
  "description": "Calibration configuration for execution contention bands",
  "labels": {
    "preset": "contention"
  },
  "runOptions": {
    "randomizeTrialOrder": false,
    "failFast": true,
    "repeatCount": 1
  },
  "artifacts": {
    "outputDirectory": "build/reports/contention-calibration",
    "retainExpandedConfig": true,
    "retainRawBenchmarkOutput": true,
    "retainObserverData": true
  },
  "trials": [
    {
      "id": "contention-band-staged",
      "name": "Staged Execution Contention Band",
      "group": "contention-calibration",
      "description": "Staged policy band trial for contention calibration",
      "comparison": {
        "comparisonGroup": "contention-calibration",
        "purpose": "Evaluate staged policy under execution contention"
      },
      "tags": [
        "contention",
        "staged"
      ],
      "enabled": true,
      "origin": {
        "type": "MANUAL",
        "candidateIndex": 0
      },
      "forks": 1,
      "warmups": 1,
      "iterations": 5,
      "jvmArgs": [
        "-XX:+UseThreadPriorities",
        "--enable-native-access=ALL-UNNAMED"
      ],
      "calibrationConfig": {
        "parallelSources": 11,
        "orderedSources": 0,
        "workUnits": 24,
        "randomizeWork": false,
        "totalRequiredExecutions": 32000000,
        "invocationTimeoutMillis": 6000,
        "decisionWeights": {
          "idleContentionThresholds": {
            "xsContention": 1000000,
            "sContention": 1000000,
            "mContention": 1000000,
            "hContention": 1000000
          },
          "idleBodyCostWeights": [
            { "xs": 0, "s": 0, "m": 0, "h": 0 },
            { "xs": 0, "s": 0, "m": 0, "h": 0 },
            { "xs": 0, "s": 0, "m": 0, "h": 0 },
            { "xs": 0, "s": 0, "m": 0, "h": 0 }
