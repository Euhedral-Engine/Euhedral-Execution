<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.euhedral-execution</groupId>
    <artifactId>euhedral-execution</artifactId>
    <version>0.0.7-SNAPSHOT</version>
  </parent>

  <name>Euhedral Hardware Utils</name>
  <artifactId>euhedral-hardware-utils</artifactId>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <llvm.readobj>/usr/bin/llvm-readobj</llvm.readobj>
    <llvm.objdump>/usr/bin/llvm-objdump</llvm.objdump>
    <native.generated.resources>${project.build.directory}/generated-resources/native</native.generated.resources>
  </properties>

  <dependencies>
    <!--    Annotations   -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--    Data Structures   -->
    <dependency>
      <groupId>it.unimi.dsi</groupId>
      <artifactId>fastutil</artifactId>
    </dependency>

    <!--    Logging   -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!--    Testing   -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>9.9.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <includes>
          <include>logback-fragments/**</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <p0.project.basedir>${project.basedir}</p0.project.basedir>
            <p0.classes.directory>${project.build.outputDirectory}</p0.classes.directory>
            <p0.build.directory>${project.build.directory}</p0.build.directory>
            <p1.rcodesign>${env.RCODESIGN}</p1.rcodesign>
            <p1.llvm.readobj>${llvm.readobj}</p1.llvm.readobj>
            <p1.llvm.objdump>${llvm.objdump}</p1.llvm.objdump>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>17</release>
          <showWarnings>true</showWarnings>
          <showDeprecation>true</showDeprecation>
          <compilerArgs>
            <arg>-h</arg>
            <arg>${project.build.directory}/generated-jni/declarations</arg>
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>remove-stale-native-resources</id>
            <phase>process-classes</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <fail message="native-package: generated resource path is unsafe: ${native.generated.resources}">
                  <condition>
                    <or>
                      <equals arg1="${native.generated.resources}" arg2="" />
                      <equals arg1="${native.generated.resources}" arg2="${project.basedir}" />
                      <equals arg1="${native.generated.resources}" arg2="${project.build.directory}" />
                      <equals arg1="${native.generated.resources}" arg2="${maven.multiModuleProjectDirectory}" />
                      <contains string="${native.generated.resources}" substring="$${" />
                    </or>
                  </condition>
                </fail>
                <delete dir="${native.generated.resources}"
                  followSymlinks="false" removeNotFollowedSymlinks="true" />
                <delete dir="${project.build.outputDirectory}/bin"
                  followSymlinks="false" removeNotFollowedSymlinks="true" />
                <delete file="${project.build.outputDirectory}/META-INF/euhedral/native-products.tsv"
                  followSymlinks="false" removeNotFollowedSymlinks="true" />
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>zig-build</id>
            <phase>process-classes</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${env.ZIG}</executable>
              <workingDirectory>${project.basedir}/src/main/native</workingDirectory>
              <arguments>
                <argument>build</argument>
                <argument>-Djava-home=${java.home}</argument>
                <argument>-Dgenerated-jni=${project.build.directory}/generated-jni</argument>
                <argument>-Doutput-root=${native.generated.resources}</argument>
                <argument>-Dmacos-sdk=${env.SDKROOT}</argument>
                <argument>-Drcodesign=${env.RCODESIGN}</argument>
                <argument>--cache-dir</argument>
                <argument>${project.build.directory}/zig-cache</argument>
                <argument>--global-cache-dir</argument>
                <argument>${project.build.directory}/zig-global-cache</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-generated-native-resources</id>
            <phase>process-classes</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${native.generated.resources}</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>bin/**</include>
                    <include>META-INF/euhedral/native-products.tsv</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>llvm-readobj-environment</id>
      <activation>
        <property>
          <name>env.LLVM_READOBJ</name>
        </property>
      </activation>
      <properties>
        <llvm.readobj>${env.LLVM_READOBJ}</llvm.readobj>
      </properties>
    </profile>
    <profile>
      <id>llvm-objdump-environment</id>
      <activation>
        <property>
          <name>env.LLVM_OBJDUMP</name>
        </property>
      </activation>
      <properties>
        <llvm.objdump>${env.LLVM_OBJDUMP}</llvm.objdump>
      </properties>
    </profile>
  </profiles>

</project>
